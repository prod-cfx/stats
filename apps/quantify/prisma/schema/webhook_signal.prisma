enum WebhookSignalSubscriptionStatus {
  ACTIVE
  DISABLED
  ROTATED
}

enum WebhookSignalSignatureStatus {
  ACCEPTED
  REJECTED
}

model WebhookSignalSubscription {
  id                 String                          @id @default(cuid())
  userId             String                          @map("user_id")
  strategyInstanceId String                          @map("strategy_instance_id")
  provider           String?
  signalId           String                          @map("signal_id")
  secretCiphertext   String                          @map("secret_ciphertext") @db.Text
  secretVersion      Int                             @default(1) @map("secret_version")
  status             WebhookSignalSubscriptionStatus @default(ACTIVE)
  lastAcceptedAt     DateTime?                       @map("last_accepted_at")
  rotatedAt          DateTime?                       @map("rotated_at")
  disabledAt         DateTime?                       @map("disabled_at")
  metadata           Json?
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyInstance StrategyInstance     @relation(fields: [strategyInstanceId], references: [id], onDelete: Cascade)
  events           WebhookSignalEvent[]
  audits           WebhookSignalAudit[]

  @@index([userId, status], map: "idx_webhook_signal_subscriptions_user_status")
  @@index([strategyInstanceId, signalId, status], map: "idx_webhook_signal_subscriptions_instance_signal_status")
  @@index([createdAt], map: "idx_webhook_signal_subscriptions_created_at")
  @@unique([id, strategyInstanceId, signalId], map: "uniq_webhook_signal_subscriptions_id_instance_signal")
  @@map("webhook_signal_subscriptions")
}

model WebhookSignalEvent {
  id                 String                       @id @default(cuid())
  subscriptionId     String                       @map("subscription_id")
  strategyInstanceId String                       @map("strategy_instance_id")
  provider           String?
  signalId           String                       @map("signal_id")
  dedupeKey          String                       @map("dedupe_key")
  payload            Json
  sanitizedHeaders   Json?                        @map("sanitized_headers")
  rawBodySha256      String?                      @map("raw_body_sha256")
  signatureStatus    WebhookSignalSignatureStatus @default(ACCEPTED) @map("signature_status")
  sourceTimestamp    DateTime?                    @map("source_timestamp")
  receivedAt         DateTime                     @default(now()) @map("received_at")
  createdAt          DateTime                     @default(now()) @map("created_at")

  subscription     WebhookSignalSubscription @relation(fields: [subscriptionId, strategyInstanceId, signalId], references: [id, strategyInstanceId, signalId], onDelete: Cascade)
  strategyInstance StrategyInstance          @relation(fields: [strategyInstanceId], references: [id], onDelete: Cascade)
  audits           WebhookSignalAudit[]

  @@unique([subscriptionId, dedupeKey], map: "uniq_webhook_signal_events_subscription_dedupe_key")
  @@index([subscriptionId, receivedAt], map: "idx_webhook_signal_events_subscription_received")
  @@index([strategyInstanceId, signalId, receivedAt], map: "idx_webhook_signal_events_instance_signal_received")
  @@index([signatureStatus, receivedAt], map: "idx_webhook_signal_events_signature_received")
  @@map("webhook_signal_events")
}

model WebhookSignalAudit {
  id                 BigInt                       @id @default(autoincrement())
  subscriptionId     String?                      @map("subscription_id")
  eventId            String?                      @map("event_id")
  strategyInstanceId String?                      @map("strategy_instance_id")
  provider           String?
  signalId           String?                      @map("signal_id")
  dedupeKey          String?                      @map("dedupe_key")
  signatureStatus    WebhookSignalSignatureStatus @map("signature_status")
  reason             String?                      @db.Text
  requestHeadersRedacted Json?                    @map("request_headers_redacted")
  rawBodySha256      String?                      @map("raw_body_sha256")
  remoteIp           String?                      @map("remote_ip")
  userAgent          String?                      @map("user_agent")
  receivedAt         DateTime                     @default(now()) @map("received_at")
  createdAt          DateTime                     @default(now()) @map("created_at")

  subscription     WebhookSignalSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  event            WebhookSignalEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  strategyInstance StrategyInstance?          @relation(fields: [strategyInstanceId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, receivedAt], map: "idx_webhook_signal_audits_subscription_received")
  @@index([strategyInstanceId, signalId, receivedAt], map: "idx_webhook_signal_audits_instance_signal_received")
  @@index([signatureStatus, receivedAt], map: "idx_webhook_signal_audits_signature_received")
  @@index([dedupeKey], map: "idx_webhook_signal_audits_dedupe_key")
  @@map("webhook_signal_audits")
}
